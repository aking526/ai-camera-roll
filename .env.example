# Copy this file to .env and add your provider credentials.
OPENCODE_GO_API_KEY=

# Use a bare model ID supported by Go's Chat Completions endpoint.
OPENCODE_GO_MODEL=deepseek-v4.1-flash

# Cloudflare Workers AI: use an API token with Workers AI read/write permissions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Image generation and editing model supported by the image adapter.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
